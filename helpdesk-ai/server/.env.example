DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10:5173
NODE_ENV=development

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_REGION=ap-southeast-1

AWS_SIMULATION_LAUNCH_TEMPLATE_ID=

SIMULATION_TTL_MINUTES=20
SIMULATION_MAX_PER_USER=1
SIMULATION_GLOBAL_MAX=1

# Local account baked into the Windows Server 2025 custom AMI. Do not include an EC2 computer name.
WINDOWS_LAB_USERNAME=labuser
WINDOWS_LAB_PASSWORD=
GUACAMOLE_BASE_URL=
# Optional same-origin launcher. Set after copying infrastructure/guacamole/guac-launch.html to the Guacamole host.
GUACAMOLE_LAUNCH_URL=
GUAC_JSON_SECRET=
GUAC_URL_TTL_SECONDS=300



JWT_ISSUER=helpdesk-ai
JWT_AUDIENCE=helpdesk-client
CHAT_RETENTION_DAYS=90
POLICY_RETENTION_DAYS=90
# Production blocks AI requests if moderation is unavailable. Explicit offline-dev override:
MODERATION_FAILURE_MODE=closed
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_USER_EMAIL=user@example.invalid
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SIMULATION_DAILY_MAX=3
SIMULATION_COOLDOWN_MINUTES=5
# Set to the exact proxy hop count in your deployment; leave unset for direct connections.
# TRUST_PROXY_HOPS=1
