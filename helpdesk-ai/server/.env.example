# Production demo template. Never copy existing local credentials into cloud settings.
NODE_ENV=production
PORT=5000
TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://helpdesk_runtime:NEW_PASSWORD@HOST/DATABASE?sslmode=require
CLIENT_URL=https://YOUR-PROJECT.vercel.app
JWT_ACCESS_SECRET=GENERATE_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_ANOTHER_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WINDOWS_SIMULATIONS_ENABLED=false
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_API_KEY=REPLACE_WITH_NEW_PROVIDER_KEY
# OpenAI moderation is also used when the answer provider is DeepSeek.
OPENAI_API_KEY=REPLACE_WITH_NEW_OPENAI_KEY
# ADMIN_DATABASE_URL belongs only in an ignored maintenance env file, never here.
