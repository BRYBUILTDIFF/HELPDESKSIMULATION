generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               Role                @default(USER)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  refreshTokens      RefreshToken[]
  sessionState       UserSessionState?
  policyEvents       PolicyEvent[]
  simulationSessions SimulationSession[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserSessionState {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SimulationModule {
  id                 String              @id
  title              String
  category           String
  difficulty         String
  simulation         Json?
  enabled            Boolean             @default(true)
  completions        Int                 @default(0)
  passRate           Float               @default(0)
  avgSteps           Float               @default(0)
  sourcePrompt       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  simulationSessions SimulationSession[]
}

model SimulationSession {
  id            String                  @id @default(cuid())
  userId        Int
  moduleId      String
  surface       String
  status        SimulationSessionStatus @default(PROVISIONING)
  ec2InstanceId String?                 @unique
  privateIp     String?
  expiresAt     DateTime
  endedAt       DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module        SimulationModule        @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, expiresAt])
}

model PolicyEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  userId     Int?
  userEmail  String
  message    String
  blocked    Boolean  @default(false)
  code       String
  reason     String
  hasHistory Boolean  @default(false)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at(sort: Desc)])
  @@index([blocked, at(sort: Desc)])
  @@index([code])
}

enum Role {
  USER
  ADMIN
}

enum SimulationSessionStatus {
  PROVISIONING
  READY
  ACTIVE
  TERMINATING
  ENDED
  FAILED
}
