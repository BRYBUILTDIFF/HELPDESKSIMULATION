# Replace GATEWAY_HOST and APP_ORIGIN and install a valid certificate first.
# Include this file from nginx's http context (for example conf.d/guacamole.conf).
map $http_upgrade $guac_connection_upgrade { default upgrade; '' close; }
# Deliberately omit query strings: Guacamole connection links carry bearer data.
log_format guac_no_args '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
  listen 80;
  server_name GATEWAY_HOST;
  access_log /var/log/nginx/guacamole-access.log guac_no_args;
  return 301 https://$host$request_uri;
}
server {
  listen 443 ssl;
  server_name GATEWAY_HOST;
  ssl_certificate /etc/letsencrypt/live/GATEWAY_HOST/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/GATEWAY_HOST/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  access_log /var/log/nginx/guacamole-access.log guac_no_args;
  add_header Referrer-Policy no-referrer always;
  add_header X-Content-Type-Options nosniff always;
  add_header Content-Security-Policy "frame-ancestors APP_ORIGIN" always;
  location = /guac-launch.html { root /var/www/html; }
  location /guacamole/ {
    proxy_pass http://127.0.0.1:8080/guacamole/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $guac_connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }
}
